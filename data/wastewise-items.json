{
  "version": 2,
  "itemCount": 141,
  "guide": "Fictional Greenfield Campus sample v1.0",
  "notice": "Knowledge catalog for identification and guide-backed routing. Not an image training dataset. Missing collection rules must be checked locally.",
  "educationSources": [
    "https://www.epa.gov/recycle/composting-home",
    "https://www.epa.gov/recycle/electronics-donation-and-recycling",
    "https://www.epa.gov/recycle/used-household-batteries"
  ],
  "rules": [
    {
      "id": "R1",
      "title": "Rigid plastic",
      "category": "Dry recycling",
      "text": "Empty rigid plastic bottles, tubs and lids go in dry recycling. Rinse away food or drink residue and let them dry. Separate lids from containers."
    },
    {
      "id": "R2",
      "title": "Paper and cardboard",
      "category": "Dry recycling",
      "text": "Clean, dry paper and cardboard go in dry recycling. Flatten boxes. Tear off greasy or food-soiled sections and put those sections in general waste."
    },
    {
      "id": "R3",
      "title": "Metal packaging",
      "category": "Dry recycling",
      "text": "Empty aluminium drink cans and steel food tins go in dry recycling. Rinse away residue and let them dry."
    },
    {
      "id": "R4",
      "title": "Glass containers",
      "category": "Glass collection",
      "text": "Empty glass bottles and jars go to the campus glass collection point. Rinse containers and separate lids; metal lids go in dry recycling. Broken glass is not accepted at this point; contact campus facilities for handling instructions."
    },
    {
      "id": "R5",
      "title": "Food scraps",
      "category": "Food waste",
      "text": "Fruit and vegetable scraps, banana peels, eggshells and loose tea leaves go in the food-waste bin. Remove all packaging first."
    },
    {
      "id": "R6",
      "title": "Mixed and flexible packaging",
      "category": "General waste",
      "text": "Plastic-lined paper cups, multilayer snack wrappers, flexible plastic bags and drink cartons go in general waste under this sample campus scheme. Empty remaining contents first. Separate rigid plastic lids and put them in dry recycling after rinsing and drying."
    },
    {
      "id": "R7",
      "title": "Soiled paper",
      "category": "General waste",
      "text": "Used tissues, napkins and greasy cardboard go in general waste. Clean cardboard sections may be separated, flattened and placed in dry recycling."
    },
    {
      "id": "R8",
      "title": "Batteries and electronics",
      "category": "Special collection",
      "text": "Batteries, light bulbs and small electronic devices must not go in campus bins. Take them to the staffed special-waste desk for collection."
    }
  ],
